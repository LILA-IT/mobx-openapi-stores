{
  "name": "mobx-openapi-stores",
  "version": "1.0.2",
  "description": "A MobX-based store implementation for OpenAPI generated clients",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsup",
    "prepare": "lefthook install || true",
    "prepublishOnly": "yarn build",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "fallow": "fallow dead-code --production --unused-deps",
    "fallow:audit": "fallow audit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:bench": "vitest bench --run",
    "format": "prettier --write .",
    "semantic-release": "semantic-release",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.33.0",
    "fallow": "^3.16.0",
    "jiti": "^2.5.1",
    "lefthook": "^1.12.3",
    "mobx": "^6.13.7",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "mobx": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "mobx": {
      "optional": false
    }
  },
  "resolutions": {
    "typescript": "~5.9.2",
    "fallow-type-aware": "portal:./vendor/fallow-type-aware-stub"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Jonas Fleischer <jonas.fleischer@lila-it.de>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LILA-IT/mobx-openapi-stores.git"
  },
  "bugs": {
    "url": "https://github.com/LILA-IT/mobx-openapi-stores/issues"
  },
  "homepage": "https://github.com/LILA-IT/mobx-openapi-stores#readme",
  "keywords": [
    "mobx",
    "openapi",
    "openapi-generator",
    "store",
    "typescript"
  ]
}
