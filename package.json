{
  "name": "mobx-openapi-stores",
  "version": "1.0.3",
  "description": "A MobX-based store implementation for OpenAPI generated clients",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsup",
    "prepare": "lefthook install || true",
    "prepublishOnly": "yarn build",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "openapi:generate": "bash scripts/generate-openapi-fixtures.sh",
    "type-check:openapi": "tsc --noEmit -p tsconfig.openapi-fixtures.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "fallow": "fallow dead-code --production --unused-deps",
    "fallow:audit": "fallow audit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:bench": "vitest bench --run",
    "size:check": "bash scripts/check-size-budget.sh",
    "format": "prettier --write .",
    "semantic-release": "semantic-release",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^10",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@semantic-release/changelog": "^7",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11",
    "@semantic-release/gitlab": "^13.3.3",
    "@semantic-release/npm": "^13",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "fallow": "^3.16.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.10",
    "mobx": "^6.13.7",
    "prettier": "^3.9.6",
    "semantic-release": "^25",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4"
  },
  "peerDependencies": {
    "mobx": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "mobx": {
      "optional": false
    }
  },
  "resolutions": {
    "typescript": "~5.9.2",
    "fallow-type-aware": "portal:./vendor/fallow-type-aware-stub"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Jonas Fleischer <jonas.fleischer@lila-it.de>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LILA-IT/mobx-openapi-stores.git"
  },
  "bugs": {
    "url": "https://github.com/LILA-IT/mobx-openapi-stores/issues"
  },
  "homepage": "https://github.com/LILA-IT/mobx-openapi-stores#readme",
  "keywords": [
    "mobx",
    "openapi",
    "openapi-generator",
    "store",
    "typescript"
  ]
}
